#!/usr/bin/env bash
#
# Fake gcloud for the release script tests (bead B5.2). It mints a fixed token,
# answers read-only describes and records every call. The one call it models as
# a state change is `run services update-traffic`, which is what lets
# health.bats show that a failed health check leaves the previous revision
# serving — and that the fake would record a shift if one were attempted.
#
# It also answers the Artifact Registry read digest_for_tag.sh makes (bead
# dv-35th), so the `up` flow's tag-to-digest resolution is tested against a
# registry that can be wrong in the two ways that matter: a tag that is not
# there at all, and one that resolves to no digest.
#
# The base key is never read: the fake records only *where* the credential came
# from (the environment, or a command line), never any part of its contents. It
# treats the token file the same way, recording its path and never its
# contents.
#
# Fake-specific environment:
#   FAKE_LOG           where invocations are recorded (default /dev/null)
#   FAKE_STATE         fake cloud state file (serving_revision, latest_revision)
#   FAKE_ACCESS_TOKEN  the token `auth print-access-token` prints
#   FAKE_SERVICE_URL   the URL `run services describe` answers with
#   FAKE_AR_DIGEST_HEX the digest body `artifacts docker images describe` prints
#   FAKE_AR_MISSING    a tag `artifacts docker images describe` reports as absent
#   FAKE_AR_NO_DIGEST  set, and that call succeeds while printing no digest

set -euo pipefail
# shellcheck source=scripts/release/tests/fakes/_fake.sh
. "$(dirname "${BASH_SOURCE[0]}")/_fake.sh"

service_url=${FAKE_SERVICE_URL:-https://fractals-nextjs-staging-abc123.us-central1.run.app}

# mutating_words are the verbs that would change the cloud. A call containing
# one is recorded as a MUTATION, so a test can assert that a script made none.
mutating_words='^(deploy|delete|update|create|add-iam-policy-binding|remove-iam-policy-binding|set-iam-policy|update-traffic|resume|pause)$'

record() {
  local word mutation=no
  for word in "$@"; do
    [[ $word =~ $mutating_words ]] && mutation=yes
  done
  if [[ $mutation == yes ]]; then
    fake_mutation "gcloud $*"
  else
    fake_log "gcloud $*"
  fi
}

case ${1:-} in
auth)
  case ${2:-} in
  print-access-token)
    shift 2
    key_env=no
    key_argv=no
    if [[ -n ${CLOUDSDK_AUTH_CREDENTIAL_FILE_OVERRIDE:-} ]]; then key_env=yes; fi
    for word in "$@"; do
      [[ $word == "${CLOUDSDK_AUTH_CREDENTIAL_FILE_OVERRIDE:-@@none@@}" ]] && key_argv=yes
    done
    fake_log "gcloud auth print-access-token key_env=$key_env key_argv=$key_argv $*"
    printf '%s\n' "${FAKE_ACCESS_TOKEN:-fake-access-token-0123456789}"
    ;;
  *)
    fake_log "gcloud $*"
    ;;
  esac
  ;;
artifacts)
  case "${2:-} ${3:-} ${4:-}" in
  'docker images describe')
    shift 4
    image=${1:-}
    # The token file's *path* is recorded, as auth records the key's: the fake
    # proves where the credential came from and never what it holds. The token
    # itself is read by gcloud from that file, so the real call has it on no
    # command line either.
    token_env=no
    for word in "$@"; do
      [[ $word == --access-token-file=* ]] && token_env=yes
    done
    fake_log "gcloud artifacts docker images describe $image token_file=$token_env"
    tag=${image##*:}
    # A tag the test says is not there: gcloud fails, as it does for an image
    # the repository does not hold.
    if [[ -n ${FAKE_AR_MISSING:-} && $tag == "${FAKE_AR_MISSING}" ]]; then
      printf 'ERROR: (gcloud.artifacts.docker.images.describe) NOT_FOUND: %s\n' "$image" >&2
      exit 1
    fi
    # The other shape of a tag that maps to no digest: the call succeeds and
    # answers with nothing.
    [[ -z ${FAKE_AR_NO_DIGEST:-} ]] || exit 0
    printf 'sha256:%s\n' "${FAKE_AR_DIGEST_HEX:-$(printf 'ab%.0s' {1..32})}"
    ;;
  *)
    record "$@"
    ;;
  esac
  ;;
compute)
  # The disk list k8s_lib.sh reads. A call with a --filter asks for the volume
  # disks (FAKE_DISKS); one without asks for every disk in the project
  # (FAKE_DISKS_ALL, which defaults to FAKE_DISKS). Both are space-separated names.
  case "${2:-} ${3:-}" in
  'disks list')
    filtered=no
    for word in "$@"; do
      [[ $word == --filter=* ]] && filtered=yes
    done
    record "$@"
    [[ -z ${FAKE_DISKS_FAIL:-} ]] || exit 1
    if [[ $filtered == yes ]]; then
      names=${FAKE_DISKS:-}
      # FAKE_DISKS_AFTER_RELEASE is what the project lists once kubectl has been
      # asked to delete the namespaces (the fake kubectl notes it).
      if [[ -n ${FAKE_DISKS_AFTER_RELEASE+set} && $(fake_state_get released) == 1 ]]; then
        names=$FAKE_DISKS_AFTER_RELEASE
      fi
    else
      names=${FAKE_DISKS_ALL:-${FAKE_DISKS:-}}
    fi
    read -ra list <<<"$names"
    [[ ${#list[@]} -eq 0 ]] || printf '%s\n' "${list[@]}"
    ;;
  *)
    record "$@"
    ;;
  esac
  ;;
scheduler)
  # update, resume and pause of the reaper job are mutations (mutating_words).
  record "$@"
  ;;
run)
  case "${2:-} ${3:-}" in
  'services describe')
    format=''
    for word in "$@"; do
      case $word in
      --format=*) format=${word#--format=} ;;
      esac
    done
    record "$@"
    case $format in
    *latestReadyRevisionName*) fake_state_get latest_revision ;;
    *) printf '%s\n' "$service_url" ;;
    esac
    ;;
  'services update-traffic')
    # The only modeled mutation: traffic moves to the newest revision.
    record "$@"
    fake_state_set serving_revision "$(fake_state_get latest_revision)"
    ;;
  *)
    record "$@"
    ;;
  esac
  ;;
*)
  record "$@"
  ;;
esac
