#!/usr/bin/env bash
#
# Fake docker for the release script tests (bead B5.2). It builds nothing and
# pushes nothing: it records what it was asked to do, and answers `inspect` with
# a digest derived from the image reference it was given, which is what makes
# the printed digest in build_push.bats match the image the fake was told to
# push.
#
# Fake-specific environment:
#   FAKE_LOG          where invocations are recorded (default /dev/null)
#   FAKE_DIGEST_HEX   64 lowercase hex characters, default eight `deadbeef`
#
# A build is also where the bound a script puts on it is tested (bead dv-96nw),
# so a `build` reads four more:
#
#   FAKE_DOCKER_BUILD_SECONDS  how long the build takes. It moves the test's
#                              clock on by that much, the way the fake curl
#                              moves it by FAKE_CURL_SECONDS, so the script's own
#                              bound is what decides. Unset, the build is over
#                              at once, as every other fake's work is.
#   FAKE_DOCKER_BUILD_HANGS    1 is a build that never returns: the clock has
#                              moved and docker has nothing more to say, which is
#                              the shape 2026-10-15's stall had. The script's
#                              bound is what ends it; when the bound does not,
#                              this fake ends it itself (see the cap below), so
#                              a bound that fails costs the test seconds and not
#                              the file's budget (dv-fcq2).
#   FAKE_DOCKER_BUILD_STATUS   the build's exit status, default 0.
#   FAKE_DOCKER_BUILD_LINES    how many numbered lines the build writes before
#                              it ends, so a test can say which of them the
#                              script printed after it stopped.
#
# A hung build is also the one thing here that outlives the test's clock: how
# long it hangs for is real seconds, so it has a real-time cap of its own,
# FAKE_DOCKER_HANG_CAP_SECONDS (default 90). The script's bound is the only
# other thing that ends a hang, and a bound that does not end one is what
# dv-honu.7's third rejection looked like (the file ran 495 s and the gate's
# budget killed it). Under the cap, a bound that fails costs a test a minute at
# worst, and the test fails on the message below rather than on the file's
# budget.

set -euo pipefail
# shellcheck source=scripts/release/tests/fakes/_fake.sh
. "$(dirname "${BASH_SOURCE[0]}")/_fake.sh"

digest=${FAKE_DIGEST_HEX:-deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef}
container=${FAKE_DOCKER_CONTAINER_ID:-3f2a1b0c9d8e}

case ${1:-} in
build | push)
  fake_log "docker $*"

  if [[ ${1:-} == build ]]; then
    if [[ -n ${FAKE_DOCKER_BUILD_LINES:-} ]]; then
      for ((line = 1; line <= FAKE_DOCKER_BUILD_LINES; line++)); do
        printf 'build line %d\n' "$line"
      done
    fi
    if [[ -n ${FAKE_DOCKER_BUILD_SECONDS:-} ]]; then
      fake_clock_advance "$FAKE_DOCKER_BUILD_SECONDS"
    fi
    if [[ ${FAKE_DOCKER_BUILD_HANGS:-0} == 1 ]]; then
      # The hang ends when the script's bound kills it, which takes this whole
      # process with it and prints nothing. Everything below is for the case
      # where that does not happen, so that a bound which misses cannot spend a
      # budget: the loop ends itself when the process that ran the build is
      # gone (nothing is left to stop it, and its reader is waiting), and
      # after a real-time cap. The clock here is bash's $SECONDS and not the
      # test's: FAKE_CLOCK_FILE is what the test drives, so a hang measured on
      # it would never end. Both endings are non-zero and say so, and the hang
      # tests that reach one fail on this line instead of on the file's budget.
      hang_cap=${FAKE_DOCKER_HANG_CAP_SECONDS:-90}
      if [[ ! $hang_cap =~ ^[0-9]+$ ]] || ((hang_cap < 1)); then
        printf 'fake docker: FAKE_DOCKER_HANG_CAP_SECONDS must be a whole number of seconds, got: %s\n' "$hang_cap" >&2
        exit 2
      fi
      hang_start=$SECONDS
      # /bin/sleep, not sleep: the script's PATH has the fake one, which does
      # not wait, and a build that hangs has to stay there until it is stopped.
      while :; do
        if ! kill -0 "$PPID" 2>/dev/null; then
          printf "fake docker: hung build was never stopped by the script's bound: the process that ran it (pid %s) is gone\n" "$PPID" >&2
          exit 1
        fi
        if ((SECONDS - hang_start >= hang_cap)); then
          printf "fake docker: hung build was never stopped by the script's bound: still running after %ss\n" "$hang_cap" >&2
          exit 1
        fi
        /bin/sleep 0.05
      done
    fi
    exit "${FAKE_DOCKER_BUILD_STATUS:-0}"
  fi
  ;;
ps)
  # `docker ps` and `docker ps --quiet`, which is what a script prints when it
  # has stopped a build (build_container_diagnostics). One container is running
  # unless a test says none is.
  fake_log "docker $*"
  if [[ ${FAKE_DOCKER_NO_CONTAINERS:-0} == 1 ]]; then
    exit 0
  fi
  if [[ $* == *--quiet* ]]; then
    printf '%s\n' "$container"
  else
    printf '  %s  node:20  Up 51 minutes  build\n' "$container"
  fi
  ;;
top)
  fake_log "docker $*"
  printf 'UID   PID   PPID  C  STIME  TTY  TIME      CMD\n'
  printf 'root  1234  1     0  17:35  ?    00:00:00  next build\n'
  ;;
login)
  # The password arrives on stdin (docker --password-stdin) and is never read
  # into a variable, never logged and never echoed. Only its size is recorded,
  # so a test can prove the token did not travel on the command line.
  fake_log "docker login password-on-stdin bytes=$(fake_stdin_bytes) ${*#login }"
  ;;
inspect)
  # The last argument is the image reference build_push.sh tagged, e.g.
  # us-central1-docker.pkg.dev/gt-fractals-m4xq/apps/fractals-nextjs:v1.0.0. The tag
  # is dropped, because a RepoDigest is emitted per repository, not per tag.
  shift $(($# - 1))
  ref=$1
  fake_log "docker inspect ref=$ref"
  printf '%s@sha256:%s\n' "${ref%:*}" "$digest"
  ;;
*)
  fake_log "docker $*"
  exit 0
  ;;
esac
