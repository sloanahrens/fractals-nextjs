#!/usr/bin/env bash
#
# Fake date for the release script tests (bead dv-bte). up.sh and promote.sh
# stamp the stack's `deployedAt` config with the time they apply, and the one
# thing a test cannot otherwise make happen is a clock that answers with
# something that is not a timestamp. FAKE_DATE_BAD=1 is that clock; without it
# this fake is the real date, so every other caller sees what it expects.
#
# It follows the fakes' two rules (_fake.sh): every call is recorded, and no
# credential value is ever read or printed.
#
# It is also the test's clock: `date +%s` answers from FAKE_CLOCK_FILE (see
# _fake.sh), so the polling scripts read time the test controls. Any other
# date call is the real date.
#
# Fake-specific environment:
#   FAKE_DATE_BAD     set to 1 to answer with text that is not an RFC 3339
#                     timestamp, so a test can watch a release refuse to deploy
#   FAKE_CLOCK_FILE   the fake clock (see _fake.sh); `date +%s` reads it
#   FAKE_DATE_DELAY   real seconds `date +%s` waits before it answers, so a test
#                     can fix the order of a race between a script's clock read
#                     and a fake command that moves the clock

set -euo pipefail
# shellcheck source=scripts/release/tests/fakes/_fake.sh
. "$(dirname "${BASH_SOURCE[0]}")/_fake.sh"

fake_log "date $*"

if [[ ${FAKE_DATE_BAD:-0} == 1 ]]; then
  printf 'a moment ago\n'
  exit 0
fi

if [[ -n ${FAKE_CLOCK_FILE:-} && $# -eq 1 && $1 == '+%s' ]]; then
  # FAKE_DATE_DELAY is a number of real seconds to wait before answering. It
  # lets a test decide the order of a race it is about, instead of hoping for
  # it: a script that launches a command and then reads the clock gives a fake
  # command that moves the clock the time to do so first (bead dv-lqrk).
  # /bin/sleep, not sleep: the fake sleep moves the clock instead of waiting.
  if [[ -n ${FAKE_DATE_DELAY:-} ]]; then
    /bin/sleep "$FAKE_DATE_DELAY"
  fi
  fake_clock_now
  exit 0
fi

exec /bin/date "$@"
