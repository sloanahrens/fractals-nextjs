# Cloned devops toolchain (created by the deploy system)
devops
infra

# The deploy program and the release scripts the deploy runner executes from
# its own checkout; neither runs inside the app's image (deploy/README.md).
# The one exception is the deployment's params file: next.config.js reads it at
# build time and compiles the value the app uses into the server, so it must be
# in the build context, but it is never copied into the image.
deploy/*
!deploy/params.json
scripts

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js build output
.next
out

# IDE and editor files
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

# Git
.git
.gitignore

# Docker
Dockerfile
.dockerignore

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ESLint cache
.eslintcache